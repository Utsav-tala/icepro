# frontend/.env.example
# Copy to frontend/.env and fill in real values. Never commit the real .env file.

# ─── Backend API origin ───────────────────────────────────────────────────────
# The ORIGIN ONLY — no trailing "/api", no trailing slash. The code appends "/api".
#   Production:  https://icepro-api.onrender.com
#   Local dev:   leave BLANK. The "proxy" field in package.json forwards /api to
#                localhost:8000 automatically. That proxy is a dev-server-only feature
#                and does NOT exist in a production build — hence this variable.
#
# On Vercel this must be set in the dashboard (Settings -> Environment Variables).
# If it is missing, the deployed app asks Vercel for /api and gets a 404 on every
# request: the UI loads, then nothing works.
REACT_APP_API_URL=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Used for "Sign in with Google" (Auth.js). Must match GOOGLE_CLIENT_ID in backend/.env —
# same Google Cloud OAuth app, used on both sides of the handshake.
# Also add the deployed frontend URL to "Authorized JavaScript origins" in the Google
# Cloud console, or Google will reject the sign-in.
REACT_APP_GOOGLE_CLIENT_ID=
