# frontend/.env.example
# Copy to frontend/.env and fill in real values. Never commit the real .env file.

# Google OAuth Client ID — used for "Sign in with Google" (Auth.js).
# Must match the Client ID configured in backend/.env (GOOGLE_CLIENT_ID) —
# same Google Cloud OAuth app, used on both sides of the handshake.
REACT_APP_GOOGLE_CLIENT_ID=
