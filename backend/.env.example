# backend/.env.example
# Copy to backend/.env for local dev. Never commit the real .env.
#
# This file is also the DEPLOYMENT CHECKLIST. Every variable marked [PROD] must be set
# in the Render dashboard (Environment tab) or something breaks — usually silently.
# See DEPLOYMENT.md for the full walkthrough.

# ─── Server ───────────────────────────────────────────────────────────────────
# Render injects PORT itself and expects the app to bind to it. Do NOT hardcode PORT
# in the Render dashboard — the code already reads process.env.PORT.
PORT=8000

# [PROD] Must be exactly "production" on Render.
# This one variable switches the refresh-token cookie to secure + sameSite=none, which
# is what makes login survive across two different domains (Vercel <-> Render). Forget it
# and auth breaks in a way that looks like a mysterious bug, not a config mistake.
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# [PROD] Atlas connection string.
# Atlas -> Network Access must allow Render's IPs. Render has no fixed outbound IP on the
# free tier, so in practice you allow 0.0.0.0/0 and rely on a strong DB password.
# For Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/icepro?retryWrites=true&w=majority
# For local:  mongodb://localhost:27017/icepro
MONGO_URI=mongodb://localhost:27017/icepro

# ─── Cross-origin wiring (frontend <-> backend) ───────────────────────────────
# These two are the #1 cause of "it worked on localhost" deployment failures.

# [PROD] The browser origin allowed by CORS. Set to the live Vercel URL.
# If unset in production the code falls back to a placeholder domain, and EVERY API call
# is blocked by the browser.
# Example: https://icepro.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# [PROD] Base URL used to build links inside emails (verify-email / reset-password).
# If unset it defaults to http://localhost:3000, so every user who signs up receives an
# email whose link points at their OWN computer. The link is dead and they can never verify.
# Example: https://icepro.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── Session tokens ───────────────────────────────────────────────────────────
#   ACCESS  — short-lived, sent in the Authorization header. Keep it short: it cannot be
#             revoked, so its lifetime IS the blast radius of a stolen one.
#   REFRESH — long-lived, httpOnly cookie, hashed in the DB, ROTATED on every use.
#             Revocable: logout deletes its hash, which kills the session for real.
# [PROD] Generate fresh random values for production. Do not reuse the dev ones.
#        A quick generator:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_minimum_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_DIFFERENT_long_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Signup gate ──────────────────────────────────────────────────────────────
# [PROD] Seeds the signup secret code on first boot if Settings has none stored yet.
# Once a code exists in the database, the Settings page is the source of truth and this
# value is ignored.
SIGNUP_SECRET=replace_with_the_code_you_hand_to_staff

# Lifetime of the short-lived ticket issued after the secret code is accepted.
SIGNUP_TICKET_EXPIRY=15m

# ─── Login lockout ────────────────────────────────────────────────────────────
# Optional — these are the defaults if omitted.
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# ─── Google Sign-In ───────────────────────────────────────────────────────────
# [PROD] Must match REACT_APP_GOOGLE_CLIENT_ID in the frontend — same Google Cloud OAuth app.
# Also add the deployed frontend URL to "Authorized JavaScript origins" in the Google Cloud
# console, or Google rejects the sign-in from the live site.
GOOGLE_CLIENT_ID=

# ─── Email (verification + password reset) ────────────────────────────────────
# Delivery goes through Brevo's HTTP API, not SMTP.
#
# Why: Render blocks outbound SMTP (anti-spam), so Gmail failed with
#   ETIMEDOUT, command: 'CONN'
# — the TCP connection to smtp.gmail.com:465 never even opened, so no credential was ever
# sent and no Gmail setting could have fixed it. Brevo's API rides HTTPS on port 443, the
# same port the rest of the app already uses, so it cannot be port-blocked.
#
# Setup (free: 300 emails/day, no card):
#   1. brevo.com -> sign up
#   2. SMTP & API -> API Keys -> Generate a new API key   -> BREVO_API_KEY
#   3. Senders & IPs -> add + VERIFY your sender address  -> EMAIL_FROM
#      Brevo rejects the send if the sender is not verified.
#
# [PROD] Without BREVO_API_KEY the app refuses to send in production rather than falling
# back to the Ethereal sandbox, which accepts mail and delivers nothing.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Vrundavan Ice Cream

# Local dev: leave BREVO_API_KEY blank and emails go to the Ethereal sandbox instead —
# nothing is delivered, but a preview URL is printed in the terminal.

# ─── Puppeteer / PDF engine ───────────────────────────────────────────────────
# Where Chrome is cached. LEAVE THIS BLANK — .puppeteerrc.cjs already pins the cache to
# backend/.cache/puppeteer so Chrome survives the build->runtime handoff on Render.
# Only set it if a host needs a different layout; a value that disagrees with the build
# location is exactly how you get "Could not find Chrome" at runtime.
PUPPETEER_CACHE_DIR=

# Minutes of inactivity after which the headless Chrome instance is shut down to reclaim
# memory. Render's free tier gives only 512 MB total and Chrome holds ~150-250 MB while
# idle. The next PDF request relaunches it (costs ~1-2s). Set to 0 to keep it alive forever.
PDF_BROWSER_IDLE_MINUTES=5
