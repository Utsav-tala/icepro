# Single root .gitignore covering both frontend/ and backend/.
# (Consolidated from the old root + backend/.gitignore — see ICEPRO_MEMORY.md Section 3.)

# dependencies
node_modules/

# testing / coverage
coverage/

# production build output
frontend/build/

# environment — NEVER commit secrets
.env
**/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# uploads — keep the directory (via .gitkeep), ignore actual uploaded content
backend/uploads/*
!backend/uploads/.gitkeep

# Puppeteer's Chrome download (see backend/.puppeteerrc.cjs) — ~200MB, re-fetched on install
backend/.cache/

# local editor / agent settings
.claude/

# internal working notes — kept locally, not published
ICEPRO_MEMORY.md
TDD.md

# screenshots / marketing assets (contain live business data)
Post_Photos/

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
/.pnp
.pnp.js
